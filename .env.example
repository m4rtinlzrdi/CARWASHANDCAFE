# Local public URL used to build QR links. Replace for staging/production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase PostgreSQL connection used by the server and Drizzle migrations.
DATABASE_URL=

# Server-only Supabase configuration. Never expose service-role credentials
# through a NEXT_PUBLIC_ variable or browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Generate strong, unique values for each environment; never reuse examples.
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=

# Initial Owner bootstrap. The Owner must change the password and enable 2FA.
OWNER_EMAIL=
OWNER_INITIAL_PASSWORD=

# Keep disabled until the cafe provides official API documentation and access.
# Web orders must continue through the KDS when the external POS is unavailable.
KASIR_MODE=disabled
KASIR_API_URL=
KASIR_API_KEY=
KASIR_AUTH_TYPE=
KASIR_WEBHOOK_SECRET=

# Optional distributed rate-limit provider. Do not silently fall back to
# process-local limits in a multi-instance production deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protect scheduled jobs and outbox worker endpoints.
CRON_SECRET=
